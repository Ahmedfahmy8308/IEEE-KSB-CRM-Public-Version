# IEEE KSB CRM Environment Variables Example
# Copy this file to .env and fill in your values.

# Main Google Spreadsheet ID
SHEET_ID=your_google_spreadsheet_id_here

# Local Development Google Service Account Key File Path
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Production Inline Google Service Account Credentials (Vercel)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Auth JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(128).toString('base64'))")
JWT_SECRET=your_secure_random_jwt_secret_here

# SMTP / Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="IEEE KSB <your_email@gmail.com>"

# App URL Configuration
NEXT_PUBLIC_APP_URL=https://crm.ieee-ksb.org
NEXT_PUBLIC_BASE_URL=https://crm.ieee-ksb.org
NODE_ENV=development
